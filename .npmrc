# Your ~/.npmrc sets legacy-peer-deps=true, which makes npm skip auto-installing
# peer dependencies. A lockfile generated that way is missing entries (typescript,
# a differently-resolved zod) that stock npm expects, so `npm ci` rejects it on CI
# and the Cloudflare build fails at the install step.
#
# Pinning it false here keeps this repo on default npm behaviour regardless of
# global config, so a lockfile generated locally is always valid in CI.
legacy-peer-deps=false
