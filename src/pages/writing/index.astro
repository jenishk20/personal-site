---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { publish } from '../../utils/format';

const posts = publish(await getCollection('writing'));
---

<Base
    title="Writing"
    description="Essays on post-training, execution-verified evaluation, small local models, and agentic systems."
>
    <article>
        <h1>Writing</h1>
        <p class="lede">
            Longer pieces. Mostly post-training, evaluation that actually runs the
            output, and getting small models to punch above their parameter count.
            <a href="/rss.xml">RSS</a>.
        </p>
        <PostList items={posts} showDescription />
    </article>
</Base>
