---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE, SOCIALS } from '../consts';
import { publish } from '../utils/format';
import { codeforces, leetcode, titleCase } from '../lib/stats';

const writing = publish(await getCollection('writing')).slice(0, 5);

// Fetched at build time, like the Hugging Face numbers on /projects/.
const cf = await codeforces('jk_neu');
const lc = await leetcode('jk20');
---

<Base isHome>
    <article>
        <h1>Jenish Kothari</h1>

        <p>
            Software engineer who likes hard problems and small models that
            overperform.
        </p>

        <p>
            <strong>8&ndash;4:</strong> System design @ Adobe &mdash; authorization
            infra and asset approval workflows that stay fast and correct at
            enterprise scale.
        </p>

        <p>
            <strong>4&ndash;10:</strong> Post-training LLMs + agentic AI &mdash;
            recently fine-tuned a 7B model to beat Grok-4 on Text-to-SQL for $25.
        </p>

        <p class="lede">
            Guardian @ <a href="https://leetcode.com/u/jk20/">LeetCode</a>
            {lc.solved && <> ({lc.solved.toLocaleString('en-US')} solved, global #{lc.ranking?.toLocaleString('en-US')})</>}
            &middot; {titleCase(cf.maxRank)} @
            <a href="https://codeforces.com/profile/jk_neu">Codeforces</a>
            {cf.maxRating && <> (max {cf.maxRating})</>}
            &middot; ICPC North America Regionalist
        </p>

        <p>
            <strong><a href="/start-here/">Start here</a></strong> &middot;
            <a href="/projects/">Projects</a> &middot;
            <a href="/writing/">Writing</a>
        </p>

        {
            writing.length > 0 && (
                <>
                    <h3>Latest writing</h3>
                    <PostList items={writing} showDescription />
                </>
            )
        }

        <p>
            <a href={SOCIALS.github}>GitHub</a> &middot;
            <a href={SOCIALS.huggingface}>Hugging Face</a> &middot;
            <a href={SOCIALS.x}>X</a> &middot;
            <a href={SOCIALS.linkedin}>LinkedIn</a> &middot;
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
    </article>
</Base>
