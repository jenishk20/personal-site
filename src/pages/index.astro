---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ContestCharts from '../components/ContestCharts.astro';
import { SITE, SOCIALS } from '../consts';
import { publish } from '../utils/format';
import { codeforces, leetcode, titleCase } from '../lib/stats';

const writing = publish(await getCollection('writing')).slice(0, 5);

// Fetched at build time, like the Hugging Face numbers on /projects/.
const cf = await codeforces('jk_neu');
const lc = await leetcode('jk20');
---

<Base isHome>
    <article>
        <h1>Jenish Kothari</h1>

        <h2>About</h2>
        <p>
            Software engineer who likes hard problems and small models that
            overperform.
        </p>
        <p>
            <strong>8&ndash;4:</strong> System design @ Adobe. Authorization infra
            and asset approval workflows that stay fast and correct at enterprise
            scale.
        </p>
        <p>
            <strong>4&ndash;10:</strong> Post-training LLMs + agentic AI. Recently
            fine-tuned a 7B model to beat Grok-4 on Text-to-SQL for $25.
        </p>

        <h2>Building</h2>
        <p>
            <a href="https://vibesec-evals.streamlit.app/"><strong>VibeSec</strong></a>, a
            security benchmark for AI-generated code. 1,000 tasks, each a stable URL
            carrying the prompt, the generated app, an exploit that proves the bug,
            and a reference patch. Frontier models are scored on whether the code
            they write survives it.
        </p>

        <h2>Interests</h2>
        <ul>
            <li>
                <strong>Post-training.</strong> SFT, reasoning distillation, DPO,
                GRPO. Evaluation that <em>executes</em> the output instead of
                string-matching it, and local models above all: a 7B that fits on
                one GPU and matches a frontier model is worth more to most teams
                than an API call.
            </li>
            <li>
                <strong>Competitive programming.</strong> Aiming for the ICPC World
                Finals.
            </li>
            <li><strong>Badminton, table tennis, pickleball.</strong></li>
        </ul>

        <h2>Achievements</h2>
        <ul>
            <li>
                <strong>Winner</strong> &middot; Confluent AI Day 2025 &middot;
                $2,000 (<a
                    href="https://github.com/jenishk20/confluent-ai-hack"
                    >SecureStream AI</a
                >)
            </li>
            <li>
                <strong>Winner</strong> &middot; AI Builder Day (MadeThis) &middot;
                $1,000 (<a href="https://github.com/jenishk20/SmartGTM">SmartGTM</a>)
            </li>
            <li>
                <strong>Winner</strong> &middot;
                <a
                    href="https://www.kaggle.com/competitions/build-with-gemma-justbuild"
                    >Build with Gemma</a
                > (Kaggle &times; JustBuild) &middot; $250
            </li>
            <li>
                Guardian @ <a href="https://leetcode.com/u/jk20/">LeetCode</a>
                {lc.solved && <>({lc.solved.toLocaleString('en-US')} solved)</>}
                &middot; {titleCase(cf.maxRank)} @
                <a href="https://codeforces.com/profile/jk_neu">Codeforces</a>
                {cf.maxRating && <>(max {cf.maxRating})</>} &middot; ICPC North
                America Regionalist
            </li>
        </ul>

        <div class="photo-row">
            <figure>
                <a href="/images/confluent-ai-day.webp">
                    <img
                        src="/images/confluent-ai-day.webp"
                        alt="Jenish and two teammates on stage holding a $2,000 cheque at Confluent AI Day 2025"
                        width="440"
                        height="330"
                        loading="lazy"
                />
                </a>
                <figcaption>Confluent AI Day 2025</figcaption>
            </figure>
            <figure>
                <a href="/images/ai-builder-day.webp">
                    <img
                        src="/images/ai-builder-day.webp"
                        alt="Jenish and a teammate receiving a $1,000 cheque at AI Builder Day"
                        width="440"
                        height="330"
                        loading="lazy"
                />
                </a>
                <figcaption>AI Builder Day</figcaption>
            </figure>
            <figure>
                <a href="/images/build-with-gemma.webp">
                    <img
                        src="/images/build-with-gemma.webp"
                        alt="Group photo of the Build with Gemma hackathon participants"
                        width="440"
                        height="330"
                        loading="lazy"
                />
                </a>
                <figcaption>Build with Gemma</figcaption>
            </figure>
        </div>

        <h2>Competitive programming</h2>
        <ContestCharts compact />

        {
            writing.length > 0 && (
                <>
                    <h2>Writing</h2>
                    <PostList items={writing} showDescription />
                </>
            )
        }

        <h2>Elsewhere</h2>
        <p>
            <a href="/start-here/">Start here</a> &middot;
            <a href="/projects/">Projects</a> &middot;
            <a href="/about/">About</a>
        </p>
        <p>
            <a href={SOCIALS.github}>GitHub</a> &middot;
            <a href={SOCIALS.huggingface}>Hugging Face</a> &middot;
            <a href={SOCIALS.x}>X</a> &middot;
            <a href={SOCIALS.linkedin}>LinkedIn</a> &middot;
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
    </article>
</Base>
