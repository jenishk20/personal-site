---
import Base from './Base.astro';
import Tag from '../components/Tag.astro';
import PostStats from '../components/PostStats.astro';
import Toc from '../components/Toc.astro';
import SeriesHeader from '../components/series/SeriesHeader.astro';
import SeriesNav from '../components/series/SeriesNav.astro';
import { formatDate } from '../utils/format';
import { existsSync } from 'node:fs';
import { SERIES } from '../data/series';

interface Props {
    title: string;
    date: Date;
    description?: string;
    tag?: string;
    updated?: Date;
    likes?: boolean;
    slug: string;
    /** Raw markdown, used only for the reading-time estimate. */
    body?: string;
    backHref?: string;
    backLabel?: string;
    /** Set together: the post is that part of a series in src/data/series.ts. */
    series?: string;
    part?: number;
    /** From render(); a series part gets a contents list built from its h2s. */
    headings?: { depth: number; slug: string; text: string }[];
}

const {
    title,
    date,
    description,
    tag,
    updated,
    likes = true,
    slug,
    body = '',
    backHref = '/writing/',
    backLabel = 'All writing',
    series,
    part,
    headings = [],
} = Astro.props;

const inSeries = Boolean(series && part);

// In a link preview the heading alone ("Understanding the data and the
// benchmark") says nothing about which data, so a series part also names its
// series and number. Its preview image comes from scripts/og-card.mjs.
const shareTitle = inSeries ? `${SERIES[series!].name}, Part ${part}: ${title}` : undefined;
const image = existsSync(`public/og/${slug}.png`) ? `/og/${slug}.png` : undefined;

const words = body.trim().split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
---

<Base title={title} description={description} type="article" publishedAt={date} shareTitle={shareTitle} image={image}>
    <article>
        <h1>{title}</h1>

        <p class="meta">
            {tag && <><Tag tag={tag} link /> &nbsp;</>}
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
            {updated && <> &middot; updated {formatDate(updated)}</>}
            {words > 0 && <> &middot; {minutes} min read</>}
            {/* Filled in by PostStats once the counter API responds. The
                separator is a CSS ::before on the span, so a hidden or
                not-yet-loaded count leaves no dangling middot. */}
            {likes && <span class="views" data-views hidden />}
        </p>

        {inSeries && <SeriesHeader series={series!} part={part!} />}
        {inSeries && <Toc headings={headings} />}

        <div class="prose">
            <slot />
        </div>

        {inSeries && <SeriesNav series={series!} part={part!} />}

        {likes && <PostStats slug={slug} />}
    </article>

    <p style="margin-top:2.5rem"><a href={backHref}>&larr; {backLabel}</a></p>
</Base>
