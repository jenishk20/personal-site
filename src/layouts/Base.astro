---
import { getCollection } from 'astro:content';
import { interviews } from '../data/interviews';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { SITE, NAV, SOCIALS } from '../consts';

interface Props {
    title?: string;
    description?: string;
    /** Set on article pages so search engines get the right schema type. */
    type?: 'website' | 'article';
    publishedAt?: Date;
    /** Suppress the JSON-LD Person block on pages that aren't the homepage. */
    isHome?: boolean;
    /** Title for browser tabs and link previews, when it needs more context than
        the on-page heading (a series part names its series and number). */
    shareTitle?: string;
    /** Site-relative path to a 1200x630 link-preview image. */
    image?: string;
}

const {
    title,
    description = SITE.description,
    type = 'website',
    publishedAt,
    isHome = false,
    shareTitle,
    image,
} = Astro.props;

const pageTitle = (shareTitle ?? title) ? `${shareTitle ?? title} · ${SITE.title}` : SITE.title;

// Derived from `site` in astro.config.mjs — always ends in a slash.
// The localhost fallback only applies if `site` is ever unset.
const siteUrl = Astro.site?.href ?? 'http://localhost:4321/';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const currentPath = Astro.url.pathname;

// Hide Writing from the nav while nothing is published, so the link never
// leads to an empty page. It reappears on its own with the first post.
const hasWriting = (await getCollection('writing')).some(
    (e) => import.meta.env.DEV || !e.data.draft,
);
const nav = NAV.filter(
    (item) =>
        (item.href !== '/writing/' || hasWriting) &&
        (item.href !== '/interviews/' || interviews.length > 0),
);

const personSchema = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Person',
            '@id': `${siteUrl}#person`,
            name: SITE.author,
            url: siteUrl,
            description: SITE.tagline,
            jobTitle: 'Software Engineer II',
            worksFor: { '@type': 'Organization', name: 'Adobe' },
            alumniOf: [
                { '@type': 'CollegeOrUniversity', name: 'Northeastern University' },
                { '@type': 'CollegeOrUniversity', name: 'Nirma University' },
            ],
            knowsAbout: [
                'Post-training',
                'Reinforcement learning from human feedback',
                'Direct Preference Optimization',
                'Text-to-SQL',
                'Local language models',
            ],
            sameAs: Object.values(SOCIALS),
        },
        {
            '@type': 'WebSite',
            '@id': `${siteUrl}#website`,
            name: SITE.title,
            url: siteUrl,
            author: { '@id': `${siteUrl}#person` },
            publisher: { '@id': `${siteUrl}#person` },
        },
    ],
};
---

<!doctype html>
<html lang={SITE.locale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <meta property="og:type" content={type} />
        <meta property="og:title" content={shareTitle ?? title ?? SITE.title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content={SITE.title} />
        {
            publishedAt && (
                <meta
                    property="article:published_time"
                    content={publishedAt.toISOString()}
                />
            )
        }
        {
            image && (
                <>
                    <meta property="og:image" content={new URL(image, siteUrl).href} />
                    <meta property="og:image:width" content="1200" />
                    <meta property="og:image:height" content="630" />
                    <meta name="twitter:image" content={new URL(image, siteUrl).href} />
                </>
            )
        }
        <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:creator" content="@JenishKothari11" />

        <!-- No visible RSS link anywhere, by choice. This tag is what lets a feed
             reader find /rss.xml when someone pastes in the site's address. -->
        <link
            rel="alternate"
            type="application/rss+xml"
            title={SITE.title}
            href={`${siteUrl}rss.xml`}
        />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        {
            isHome && (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(personSchema)}
                />
            )
        }
    </head>
    <body>
        <main>
            <nav>
                {
                    nav.map((item) => (
                        <a
                            href={item.href}
                            aria-current={currentPath === item.href ? 'page' : undefined}
                        >
                            {item.label}
                        </a>
                    ))
                }
            </nav>

            <slot />

            <footer>
                <p>
                    {SITE.author} &middot; <a href={SOCIALS.x}>X</a> &middot;
                    <a href={SOCIALS.github}>GitHub</a> &middot;
                    <a href={SOCIALS.huggingface}>Hugging Face</a> &middot;
                    <a href={SOCIALS.linkedin}>LinkedIn</a>
                </p>
            </footer>
        </main>
    </body>
</html>
