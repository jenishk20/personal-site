---
import type { RatingPoint } from '../lib/stats';

/**
 * A contest-rating line chart, rendered as inline SVG at build time.
 *
 * One series, so no legend: the caption above the plot names it. Values are
 * direct-labelled selectively (peak and current only, never a number per
 * point), the grid is a solid hairline one shade off the surface, and the line
 * colour is a token validated for contrast against both surfaces.
 *
 * No hover layer, because this site ships no client JavaScript beyond the like
 * button. Every number a reader wants is printed on the chart or in the
 * caption, so nothing is reachable only by hovering.
 */
interface Props {
    points: RatingPoint[];
    /** Names the series, in the caption and for screen readers. */
    title: string;
    /**
     * Reference line. If its value sits outside the data range, the y domain
     * stretches to include it, so a target above the current peak is visible.
     */
    threshold?: { value: number; label: string };
    /** Half-width sparkline for side-by-side use. */
    compact?: boolean;
}

const { points, title, threshold, compact = false } = Astro.props;

// The viewBox is narrower in compact mode rather than just scaled down: an SVG
// scales its text with everything else, so a half-width 680px viewBox would
// render 10px labels at 5px.
const W = compact ? 340 : 680;
const H = compact ? 124 : 170;

const peak = points.reduce((a, b) => (b.r > a.r ? b : a), points[0]);
const last = points[points.length - 1];

// When the current rating IS the peak, one marker carries both facts rather
// than stacking two identical numbers. Compared by value, not timestamp: the
// peak may have first been reached at an earlier contest.
const mergedLabel = peak.r === last.r;
const endLabel = mergedLabel ? `${last.r} peak` : String(last.r);

// The right gutter holds the end label and the reference-line label; sizing it
// from the text keeps either from being clipped by the viewBox.
const gutterFor = (s: string) => Math.round(s.length * 6.2) + 16;
const PAD = {
    t: compact ? 14 : 16,
    r: Math.max(
        compact ? 44 : 52,
        gutterFor(endLabel),
        threshold ? gutterFor(threshold.label) : 0,
    ),
    b: compact ? 18 : 24,
    l: compact ? 34 : 42,
};
const plotW = W - PAD.l - PAD.r;
const plotH = H - PAD.t - PAD.b;

const tMin = points[0].t;
const tMax = points[points.length - 1].t;
const rLo = Math.min(...points.map((p) => p.r));
const rHi = Math.max(...points.map((p) => p.r));

// Stretch the domain to cover the reference line, then pad so the curve never
// touches the frame.
const domLo = Math.min(rLo, threshold?.value ?? rLo);
const domHi = Math.max(rHi, threshold?.value ?? rHi);
const pad = Math.max(40, (domHi - domLo) * 0.1);
const yLo = domLo - pad;
const yHi = domHi + pad;

const x = (t: number) => PAD.l + ((t - tMin) / (tMax - tMin)) * plotW;
const y = (r: number) => PAD.t + (1 - (r - yLo) / (yHi - yLo)) * plotH;

const round = (n: number) => Math.round(n * 10) / 10;
const path = points.map((p) => `${round(x(p.t))},${round(y(p.r))}`).join(' ');

const maxTicks = compact ? 3 : 5;
const step =
    [100, 200, 250, 500, 1000].find((s) => (yHi - yLo) / s <= maxTicks) ?? 1000;
const ticks: number[] = [];
for (let v = Math.ceil(yLo / step) * step; v <= yHi; v += step) {
    // The reference line carries its own label; skip a tick on the same value.
    if (v !== threshold?.value) ticks.push(v);
}

// At compact width the peak marker is usually too close to the current one to
// label separately; the caption carries both numbers either way.
const labelPeakSeparately = !mergedLabel && Math.abs(x(peak.t) - x(last.t)) >= 64;

const year = (t: number) => new Date(t * 1000).getUTCFullYear();
const detail = mergedLabel
    ? `${points.length} contests since ${year(tMin)} · peak ${peak.r}`
    : `${points.length} contests since ${year(tMin)} · peak ${peak.r}, now ${last.r}`;
const ariaLabel = `${title}: ${detail}`;
---

<figure class="chart">
    <figcaption><strong>{title}</strong> &middot; {detail}</figcaption>
    <svg
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label={ariaLabel}
        class="rating-chart"
    >
        {
            ticks.map((v) => (
                <>
                    <line
                        x1={PAD.l}
                        x2={W - PAD.r}
                        y1={round(y(v))}
                        y2={round(y(v))}
                        stroke="var(--border)"
                        stroke-width="1"
                    />
                    <text
                        x={PAD.l - 8}
                        y={round(y(v)) + 3}
                        text-anchor="end"
                        class="chart-tick">{v}</text>
                </>
            ))
        }

        {
            threshold && (
                <>
                    <line
                        x1={PAD.l}
                        x2={W - PAD.r}
                        y1={round(y(threshold.value))}
                        y2={round(y(threshold.value))}
                        stroke="var(--text-muted)"
                        stroke-width="1"
                    />
                    <text
                        x={W - PAD.r + 6}
                        y={round(y(threshold.value)) + 3}
                        class="chart-tick">{threshold.label}</text>
                </>
            )
        }

        <polyline
            points={path}
            fill="none"
            stroke="var(--chart-line)"
            stroke-width="2"
            stroke-linejoin="round"
            stroke-linecap="round"
        />

        {
            labelPeakSeparately && (
                <>
                    <circle
                        cx={round(x(peak.t))}
                        cy={round(y(peak.r))}
                        r="4"
                        fill="var(--chart-line)"
                        stroke="var(--bg)"
                        stroke-width="2"
                    />
                    <text
                        x={round(x(peak.t))}
                        y={round(y(peak.r)) - 9}
                        text-anchor="middle"
                        class="chart-value">
                        {peak.r} peak
                    </text>
                </>
            )
        }

        <circle
            cx={round(x(last.t))}
            cy={round(y(last.r))}
            r="4"
            fill="var(--chart-line)"
            stroke="var(--bg)"
            stroke-width="2"
        />
        <text x={round(x(last.t)) + 9} y={round(y(last.r)) + 4} class="chart-value"
            >{endLabel}</text
        >

        <text x={PAD.l} y={H - 5} class="chart-tick">{year(tMin)}</text>
        <text x={W - PAD.r} y={H - 5} text-anchor="end" class="chart-tick"
            >{year(tMax)}</text
        >
    </svg>
</figure>
