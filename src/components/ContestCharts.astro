---
import RatingChart from './RatingChart.astro';
import { codeforcesHistory, leetcodeHistory } from '../lib/stats';

interface Props {
    /** Render the two charts side by side as sparklines. */
    compact?: boolean;
}

const { compact = false } = Astro.props;

// Memoised per build, so rendering this twice costs one API call each.
const cf = await codeforcesHistory('jk_neu');
const lc = await leetcodeHistory('jk20');
---

<div class={compact ? 'chart-pair' : ''}>
    {
        cf.length > 0 && (
            <RatingChart
                points={cf}
                title="Codeforces"
                threshold={{ value: 1600, label: 'Expert' }}
                compact={compact}
            />
        )
    }
    {
        lc.length > 0 && (
            <RatingChart
                points={lc}
                title="LeetCode"
                threshold={{ value: 2500, label: '2500' }}
                compact={compact}
            />
        )
    }
</div>
