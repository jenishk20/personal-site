---
/**
 * The block under a series post's title: which series and which part. Also the
 * only place KaTeX's stylesheet is linked, so pages outside a series never
 * download it. It is linked as a plain file (copied by scripts/copy-katex.mjs)
 * rather than imported, because an import here would be bundled into the
 * stylesheet every post shares.
 */
import { SERIES } from '../../data/series';

interface Props {
    series: string;
    part: number;
}

const { series, part } = Astro.props;
const s = SERIES[series];
if (!s) throw new Error(`Unknown series "${series}". Add it to src/data/series.ts.`);
---

<link rel="stylesheet" href="/katex/katex.min.css" />

<aside class="series-header">
    <p class="series-kicker">
        <a href={`/${s.slug}/`}>{s.name}</a> &middot; Part {part} of {s.parts.length}
    </p>
    <p class="series-blurb">
        {s.blurb} The code is on <a href={s.repo}>GitHub</a>.
    </p>
</aside>
